# Selección de proveedor de modelo
# Opciones: openai | bedrock
PROVIDER=bedrock

# Configuración de OpenAI (se usa si PROVIDER=openai)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# URL base de OpenAI (opcional)
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Encabezados opcionales de organización/proyecto
# OPENAI_ORG_ID=
# OPENAI_PROJECT=

# Configuración de AWS Bedrock (se usa si PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.titan-text-lite-v1

# Supabase (opcional, solo para operaciones del servidor en /api/activity-agent)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE=

# Webhook n8n (opcional). Si se define, /api/activity-agent reenvía las peticiones a esta URL
# N8N_WEBHOOK_URL=

# Puerto del servidor
PORT=4000
